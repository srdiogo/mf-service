# Maintainer: Diogo de Medeiros <sr.diogo@gmail.com>
pkgname=mf-service
pkgver=0.1.0.r10.gdcf2ee7
pkgrel=1
pkgdesc='User-session MiniFuse control service with verified device operations'
arch=('x86_64')
url='https://github.com/srdiogo/mf-service'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('rust>=1.85' 'python' 'systemd')
options=('!debug')
optdepends=('mf-cli-platform: matching MiniFuse kernel transport and session access rules')
_commit=dcf2ee73d944b159bf247267416fb5b25db614cb
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('775ba9cd73569371c198f91e859d0fca85a63e18aa09995a111453eb13aae6bd')

prepare() {
  cd "$pkgname-$_commit"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "$pkgname-$_commit"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$_commit"
  cargo test --frozen
  make check-distribution
}

package() {
  cd "$pkgname-$_commit"
  make install DESTDIR="$pkgdir"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/INSTALL.md "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
}
